# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://kompanion.yourdomain.com

# Strava API Configuration
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session Configuration
SESSION_SECRET=your_session_secret_minimum_32_characters_long

# Database Configuration
# For local development with Docker:
DATABASE_URL="postgresql://kompanion:kompanion_dev_password@localhost:5432/kompanion_db?schema=public"

# For production with Neon (replace with your actual connection string):
# DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/database?sslmode=require"

# QStash (Upstash) — decouples webhook ack from processing. Grab the token
# and both signing keys from https://console.upstash.com/qstash. WORKER_URL
# is where QStash POSTs back; it must be the absolute, public URL of the
# /api/webhooks/process route (e.g. https://api.kompanion.app/api/webhooks/process).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
WEBHOOK_WORKER_URL=https://api.kompanion.app/api/webhooks/process
